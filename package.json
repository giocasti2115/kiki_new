{
  "name": "kiki-latam-next",
  "version": "0.1.0",
  "private": true,
  "description": "Prueba de concepto: kikilatam.com en Next.js estático con WordPress headless para el blog",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node -e \"process.env.BLOG_LOCAL_MEDIA==='1'&&require('child_process').execSync('node --env-file-if-exists=.env.local scripts/sync-media.mjs',{stdio:'inherit'})\"",
    "build": "next build",
    "preview": "python -m http.server 3001 --bind 127.0.0.1 --directory out"
  },
  "dependencies": {
    "html-react-parser": "^5.2.17",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}