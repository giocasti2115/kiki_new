# API REST del WordPress que publica el blog (por defecto, la de producción).
WP_API_URL=https://kikilatam.com/wp-json/wp/v2
# 1 = copiar las imágenes del blog al sitio (necesario cuando WordPress sea privado).
BLOG_LOCAL_MEDIA=0
# Contraseña de aplicación de WordPress (cuando la API deje de ser pública).
WP_APP_USER=
WP_APP_PASSWORD=
